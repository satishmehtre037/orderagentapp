# =============================================================================
# BizBot OS / OrderAgentAPP — Environment Template (.env.example)
# Copy this file to .env or .env.local and fill in your actual credentials.
# =============================================================================

# Server Configuration
PORT=3001

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Primary AI Provider: AgentRouter / Anthropic Claude
ANTHROPIC_AUTH_TOKEN=your-agentrouter-or-anthropic-api-token
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-5
AI_PROVIDER=claude

# Secondary AI Fallback: Groq Cloud (Llama 3.3 70B)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-meta-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_BUSINESS_NUMBER=919876543210
ADMIN_ALERT_NUMBER=919876543210

# Google Places API (For Lead Hunter Verified Directory Searches)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Razorpay Payment Gateway (Subscription & Order Payments)
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_PLAN_ID=plan_monthly_999_bizbot
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Voice Telephony Agents (Hospital & Clinic OPD Confirmations)
BLAND_API_KEY=your-bland-ai-api-key
VAPI_API_KEY=your-vapi-api-key
